{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/gustavoarielms/multi-sdd-team/main/governance/schemas/v1/gate-decision.schema.json",
  "title": "Governance Gate Decision v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "gate_id",
    "run_id",
    "gate_type",
    "required",
    "status",
    "evaluated_rule_ids",
    "finding_ids",
    "blocking_finding_ids",
    "evidence_ids",
    "exception_ids",
    "decided_by",
    "decided_at",
    "rationale"
  ],
  "properties": {
    "schema_version": {
      "$ref": "common.schema.json#/$defs/schemaVersion"
    },
    "gate_id": {
      "$ref": "common.schema.json#/$defs/gateId"
    },
    "run_id": {
      "$ref": "common.schema.json#/$defs/runId"
    },
    "gate_type": {
      "enum": ["requirements", "architecture", "deterministic", "quality", "security", "governance"]
    },
    "required": {
      "type": "boolean"
    },
    "status": {
      "enum": ["pass", "fail", "blocked", "not_run"]
    },
    "evaluated_rule_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "common.schema.json#/$defs/ruleId"
      }
    },
    "finding_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "common.schema.json#/$defs/findingId"
      }
    },
    "blocking_finding_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "common.schema.json#/$defs/findingId"
      }
    },
    "evidence_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "common.schema.json#/$defs/evidenceId"
      }
    },
    "exception_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "common.schema.json#/$defs/exceptionId"
      }
    },
    "decided_by": {
      "$ref": "common.schema.json#/$defs/producer"
    },
    "decided_at": {
      "$ref": "common.schema.json#/$defs/utcTimestamp"
    },
    "rationale": {
      "$ref": "common.schema.json#/$defs/longText"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": { "const": "pass" }
        },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "blocking_finding_ids": {
            "type": "array",
            "maxItems": 0
          },
          "evidence_ids": {
            "type": "array",
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": { "const": "fail" }
        },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "blocking_finding_ids": {
            "type": "array",
            "minItems": 1
          },
          "evidence_ids": {
            "type": "array",
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": ["blocked", "not_run"]
          }
        },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "blocking_finding_ids": {
            "type": "array",
            "maxItems": 0
          }
        }
      }
    }
  ]
}
