{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/gustavoarielms/multi-sdd-team/main/governance/schemas/v1/evidence.schema.json",
  "title": "Governance Evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evidence_id",
    "kind",
    "level",
    "outcome",
    "summary",
    "collected_at",
    "collected_by",
    "redaction"
  ],
  "properties": {
    "schema_version": {
      "$ref": "common.schema.json#/$defs/schemaVersion"
    },
    "evidence_id": {
      "$ref": "common.schema.json#/$defs/evidenceId"
    },
    "kind": {
      "enum": [
        "command_result",
        "test_result",
        "static_analysis",
        "source_location",
        "runtime_observation",
        "document",
        "human_decision"
      ]
    },
    "level": {
      "enum": ["deterministic", "reproduced", "observed", "static_inference", "heuristic"]
    },
    "outcome": {
      "enum": ["pass", "fail", "observed", "inconclusive", "not_applicable"]
    },
    "summary": {
      "$ref": "common.schema.json#/$defs/longText"
    },
    "location": {
      "$ref": "common.schema.json#/$defs/location"
    },
    "check_id": {
      "$ref": "common.schema.json#/$defs/referenceId"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uri", "sha256"],
      "properties": {
        "uri": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "media_type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "collected_at": {
      "$ref": "common.schema.json#/$defs/utcTimestamp"
    },
    "collected_by": {
      "$ref": "common.schema.json#/$defs/producer"
    },
    "redaction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["applied", "categories"],
      "properties": {
        "applied": {
          "type": "boolean"
        },
        "categories": {
          "type": "array",
          "items": {
            "enum": ["secret", "credential", "pii", "payload", "trace_identifier", "other"]
          },
          "uniqueItems": true
        },
        "note": {
          "$ref": "common.schema.json#/$defs/shortText"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "applied": { "const": true }
            },
            "required": ["applied"]
          },
          "then": {
            "properties": {
              "categories": {
                "type": "array",
                "minItems": 1
              },
              "note": {
                "$ref": "common.schema.json#/$defs/shortText"
              }
            },
            "required": ["note"]
          },
          "else": {
            "properties": {
              "categories": {
                "type": "array",
                "maxItems": 0
              }
            }
          }
        }
      ]
    }
  }
}
