{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/gustavoarielms/multi-sdd-team/main/governance/schemas/v1/engineering-gate-config.schema.json",
  "title": "Engineering Gate Configuration v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "quality_profile", "executors"],
  "properties": {
    "schema_version": { "$ref": "common.schema.json#/$defs/schemaVersion" },
    "quality_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile_id", "profile_version", "adapter_id", "adapter_version"],
      "properties": {
        "profile_id": { "const": "engineering-quality-v1" },
        "profile_version": { "const": "1.0.0" },
        "adapter_id": { "const": "node-v1" },
        "adapter_version": { "const": "1.0.0" }
      }
    },
    "executors": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "uniqueItems": true,
      "prefixItems": [
        { "const": "javascript_syntax" },
        { "const": "test_suite" },
        { "const": "governance" },
        { "const": "production_dependency_audit" },
        { "const": "npm_package_surface" },
        { "const": "forbidden_references" }
      ],
      "items": false
    }
  }
}
