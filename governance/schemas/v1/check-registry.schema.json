{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/gustavoarielms/multi-sdd-team/main/governance/schemas/v1/check-registry.schema.json",
  "title": "Governance Check Registry v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "registry_id", "checks"],
  "properties": {
    "schema_version": { "$ref": "common.schema.json#/$defs/schemaVersion" },
    "registry_id": { "$ref": "common.schema.json#/$defs/referenceId" },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["check_id", "rule_id", "implementation", "description"],
        "properties": {
          "check_id": { "$ref": "common.schema.json#/$defs/referenceId" },
          "rule_id": { "$ref": "common.schema.json#/$defs/ruleId" },
          "implementation": { "$ref": "common.schema.json#/$defs/referenceId" },
          "description": { "$ref": "common.schema.json#/$defs/shortText" }
        }
      }
    }
  }
}
