{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/gustavoarielms/multi-sdd-team/main/governance/schemas/v1/engineering-gate-registry.schema.json",
  "title": "Engineering Gate Executor Registry v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "registry_id", "executors"],
  "properties": {
    "schema_version": { "$ref": "common.schema.json#/$defs/schemaVersion" },
    "registry_id": { "const": "multi_sdd_engineering_gates" },
    "executors": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["executor_id", "implementation", "rule_ids", "timeout_ms", "max_output_bytes"],
        "properties": {
          "executor_id": { "$ref": "common.schema.json#/$defs/referenceId" },
          "implementation": { "$ref": "common.schema.json#/$defs/referenceId" },
          "rule_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "$ref": "common.schema.json#/$defs/ruleId" }
          },
          "timeout_ms": { "type": "integer", "minimum": 1, "maximum": 600000 },
          "max_output_bytes": { "type": "integer", "minimum": 1024, "maximum": 1048576 }
        }
      }
    }
  }
}
