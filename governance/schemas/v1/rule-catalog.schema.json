{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/gustavoarielms/multi-sdd-team/main/governance/schemas/v1/rule-catalog.schema.json",
  "title": "Governance Rule Catalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "catalog_id", "version", "rules"],
  "properties": {
    "schema_version": { "$ref": "common.schema.json#/$defs/schemaVersion" },
    "catalog_id": { "$ref": "common.schema.json#/$defs/referenceId" },
    "version": { "type": "integer", "minimum": 1 },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "rule.schema.json" }
    }
  }
}
