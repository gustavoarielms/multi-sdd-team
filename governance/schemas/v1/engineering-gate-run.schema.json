{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/gustavoarielms/multi-sdd-team/main/governance/schemas/v1/engineering-gate-run.schema.json",
  "title": "Engineering Gate Run v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "producer", "started_at", "completed_at", "quality_profile", "outcome", "evidence", "results"],
  "properties": {
    "schema_version": { "$ref": "common.schema.json#/$defs/schemaVersion" },
    "run_id": { "$ref": "common.schema.json#/$defs/runId" },
    "producer": {
      "allOf": [
        { "$ref": "common.schema.json#/$defs/producer" },
        { "type": "object", "properties": { "kind": { "const": "deterministic" } } }
      ]
    },
    "started_at": { "$ref": "common.schema.json#/$defs/utcTimestamp" },
    "completed_at": { "$ref": "common.schema.json#/$defs/utcTimestamp" },
    "quality_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile_id", "profile_version", "profile_digest", "adapter_id", "adapter_version"],
      "properties": {
        "profile_id": { "$ref": "common.schema.json#/$defs/referenceId" },
        "profile_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "profile_digest": { "$ref": "common.schema.json#/$defs/fingerprint" },
        "adapter_id": { "$ref": "common.schema.json#/$defs/referenceId" },
        "adapter_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" }
      }
    },
    "outcome": { "enum": ["passed", "failed", "blocked"] },
    "run_error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason_code", "summary"],
      "properties": {
        "reason_code": { "$ref": "common.schema.json#/$defs/referenceId" },
        "summary": { "$ref": "common.schema.json#/$defs/shortText" }
      }
    },
    "comparison_base": {
      "type": "object",
      "additionalProperties": false,
      "required": ["supplied_sha", "effective_merge_base_sha"],
      "properties": {
        "supplied_sha": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "effective_merge_base_sha": { "type": "string", "pattern": "^[a-f0-9]{40}$" }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 6,
      "items": { "$ref": "evidence.schema.json" }
    },
    "results": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["executor_id", "rule_ids", "status", "gate_effect", "reason_code", "summary", "duration_ms", "evidence_ids"],
        "properties": {
          "executor_id": { "$ref": "common.schema.json#/$defs/referenceId" },
          "rule_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "$ref": "common.schema.json#/$defs/ruleId" }
          },
          "status": { "enum": ["pass", "fail", "error", "not_run"] },
          "gate_effect": { "enum": ["block", "warn", "none"] },
          "reason_code": { "$ref": "common.schema.json#/$defs/referenceId" },
          "summary": { "$ref": "common.schema.json#/$defs/shortText" },
          "duration_ms": { "type": "integer", "minimum": 0, "maximum": 600000 },
          "evidence_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "$ref": "common.schema.json#/$defs/evidenceId" }
          },
          "checks": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["check_id", "rule_id", "status", "gate_effect", "summary", "evidence_ids"],
              "properties": {
                "check_id": { "$ref": "common.schema.json#/$defs/referenceId" },
                "rule_id": { "$ref": "common.schema.json#/$defs/ruleId" },
                "status": { "enum": ["pass", "fail"] },
                "gate_effect": { "enum": ["block", "warn", "none"] },
                "summary": { "$ref": "common.schema.json#/$defs/shortText" },
                "evidence_ids": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": { "$ref": "common.schema.json#/$defs/evidenceId" }
                }
              }
            }
          }
        }
      }
    }
  }
}
