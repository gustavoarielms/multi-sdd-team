{
  "name": "@gustavoarielms/sdd-codegraph-cli",
  "version": "0.1.0",
  "description": "Unpublished derivative package for Codex SDD agent configuration with optional external CodeGraph integration, based on ram4-dev/multi-sdd-team",
  "private": true,
  "type": "module",
  "bin": {
    "sdd-codegraph": "./bin/sdd-codegraph.js"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "UNLICENSED",
  "author": "rcarnicer (original project)",
  "contributors": [
    "gustavoarielms (fork maintainer)"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gustavoarielms/multi-sdd-team.git"
  },
  "homepage": "https://github.com/gustavoarielms/multi-sdd-team#readme",
  "bugs": {
    "url": "https://github.com/gustavoarielms/multi-sdd-team/issues"
  },
  "keywords": [
    "codex",
    "codegraph",
    "derivative",
    "pi-package",
    "pi",
    "sdd",
    "subagents",
    "multi-agent"
  ],
  "files": [
    "README.md",
    "NOTICE.md",
    "bin",
    "docs",
    "extensions",
    "agents",
    "prompts",
    "codex",
    "src",
    "setup.sh"
  ],
  "scripts": {
    "check": "node --check bin/sdd-codegraph.js && node --check src/installer.js && npm test",
    "setup:codex": "./setup.sh codex --global",
    "test": "node --test"
  },
  "pi": {
    "extensions": [
      "./extensions"
    ],
    "prompts": [
      "./prompts"
    ]
  },
  "peerDependencies": {
    "@mariozechner/pi-coding-agent": "*",
    "@mariozechner/pi-ai": "*",
    "@mariozechner/pi-tui": "*",
    "@sinclair/typebox": "*"
  },
  "peerDependenciesMeta": {
    "@mariozechner/pi-coding-agent": {
      "optional": true
    },
    "@mariozechner/pi-ai": {
      "optional": true
    },
    "@mariozechner/pi-tui": {
      "optional": true
    },
    "@sinclair/typebox": {
      "optional": true
    }
  }
}
