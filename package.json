{
  "name": "@gustavoarielms/sdd-codegraph-cli",
  "version": "0.3.0",
  "description": "CLI for installing Codex multi-agent SDD configuration with optional external CodeGraph integration, derived from ram4-dev/multi-sdd-team",
  "type": "module",
  "bin": {
    "sdd-codegraph": "bin/sdd-codegraph.js"
  },
  "engines": {
    "node": ">=22.14.0"
  },
  "license": "MIT",
  "author": "rcarnicer (original project)",
  "contributors": [
    "gustavoarielms (fork maintainer)"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gustavoarielms/multi-sdd-team.git"
  },
  "homepage": "https://github.com/gustavoarielms/multi-sdd-team#readme",
  "bugs": {
    "url": "https://github.com/gustavoarielms/multi-sdd-team/issues"
  },
  "keywords": [
    "codex",
    "codegraph",
    "sdd",
    "software-development",
    "multi-agent",
    "subagents",
    "orchestration",
    "governance",
    "cli"
  ],
  "files": [
    "README.md",
    "NOTICE.md",
    "bin",
    "docs",
    "codex",
    "governance",
    "src",
    "setup.sh"
  ],
  "scripts": {
    "check": "node --check bin/sdd-codegraph.js && node --check src/installer.js && node --check src/governance-validator.js && node --check src/governance-checks.js && node --check src/governance-trust.js && npm test",
    "check:governance": "node --test test/governance-schema.test.js test/governance-checks.test.js",
    "governance": "node bin/sdd-codegraph.js check-governance .",
    "setup": "./setup.sh --global",
    "test": "node --test"
  },
  "dependencies": {
    "ajv": "8.20.0"
  }
}
